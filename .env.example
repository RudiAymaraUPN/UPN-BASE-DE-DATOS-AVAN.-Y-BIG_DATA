# ===== COPIA ESTE ARCHIVO COMO ".env" EN LA RAIZ DEL REPOSITORIO Y COMPLETALO. ".env" NO SE SUBE AL REPOSITORIO. =====
# Las rutas pueden ser absolutas o relativas a la raiz del repositorio. Si las dejas vacias se usan las de data/.

# --- SQL Server (DB_USER y DB_PASSWORD vacios = autenticacion de Windows) ---
DB_SERVER=FALCON-X\SQLEXPRESS
DB_NAME=BDClinica
DB_SCHEMA=clinica
DB_USER=
DB_PASSWORD=
DW_NAME=DWClinica

# --- Carga inicial (python -m etl.carga_inicial): CSV de las 15 tablas ---
ETL_RUTA_DATA=data/inicial

# --- Carga diaria (python -m etl.carga_diaria): carpeta donde el programa de la clinica deja TABLA_AAAAMMDD.csv ---
DIARIO_RUTA_ENTRADA=data/entrada_diaria
DIARIO_RUTA_PROCESADOS=data/procesados
DIARIO_RUTA_RECHAZADOS=data/rechazos

# --- Data mart (python -m etl.datamart): Excel de inventario, Excel de metas y CSV de feriados ---
DW_RUTA_FUENTES=data/fuentes

# Sal secreta del hash SHA-256 del DNI (cambia el valor y NO lo compartas; si la cambias, los hash cambian)
DW_SAL_HASH=CAMBIAR_POR_UNA_FRASE_LARGA_Y_SECRETA
# Duracion estandar de una cita en minutos (BDClinica no la guarda; se usa para calcular cupos)
DW_DURACION_CITA_MIN=30
